{
  "name": "@wanderly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wanderly API: Fastify HTTP layer, agent runtime, RAG, guardrails.",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "node-pg-migrate -m migrations --migration-file-language sql up",
    "ingest": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/ingest.ts",
    "purge": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/purge.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "chat": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/chat.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@huggingface/transformers": "^4.3.1",
    "@langfuse/client": "^5.13.1",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@wanderly/contracts": "*",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0"
  }
}
