# Wanderly environment variables.
#
# Copy to `.env` (git-ignored) and adjust: `cp .env.example .env`.
# The API validates this file at startup and refuses to start with a readable
# list of problems (variable names only, never values). A blank value (`KEY=`)
# means "use the default". Secrets are left empty here on purpose: never commit
# real values.
#
# Milestones: M1 foundation, M2 RAG, M3 agent + traces, M4 guardrails, M5 evals.

# -----------------------------------------------------------------------------
# Runtime (M1)
# -----------------------------------------------------------------------------

# development | test | production. `production` enables Secure cookies;
# `development` pretty-prints logs (pino-pretty, dev dependency).
NODE_ENV=development

# Interface and port the API listens on (0.0.0.0 is needed inside containers).
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database (M1, required)
# -----------------------------------------------------------------------------

# Postgres 16 + pgvector. Matches the `db` service of docker-compose.yml.
# Migrations: `npm run migrate` (node-pg-migrate reads this variable too).
# Hosted databases usually need `?sslmode=require`.
DATABASE_URL=postgres://wanderly:wanderly@localhost:5432/wanderly

# -----------------------------------------------------------------------------
# HTTP security (M1)
# -----------------------------------------------------------------------------

# Comma-separated allowlist of browser origins (scheme://host[:port], no path,
# no wildcard). Defaults: Vite dev server and the web container.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Whether to trust X-Forwarded-* headers to get the client IP (rate limiting,
# logs): `false` (direct exposure), `true` (always behind a proxy that
# overwrites the header, e.g. Fly.io), or a comma-separated list of proxy
# IPs/CIDRs (`loopback`, `linklocal`, `uniquelocal` also accepted, e.g.
# `uniquelocal` for the nginx container on the compose network).
# Hop counts are not accepted: Fastify 5 ignores them for safety.
TRUST_PROXY=false

# REQUIRED SECRET, at least 32 characters. Signs the anonymous session cookie.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#   (or: openssl rand -base64 32)
SESSION_SECRET=

# Rate limit applied to the routes that opt in (the agent endpoint from M3/M4):
# at most RATE_LIMIT_MAX requests per client IP per RATE_LIMIT_WINDOW_MS.
# In-memory store: correct for a single instance only.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000

# Looser limit for the other /api routes (list, load, create, feedback).
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# LLM (M3; optional until then)
# -----------------------------------------------------------------------------

# SECRET. Anthropic API key (https://console.anthropic.com). Not needed by
# the M1 foundation.
ANTHROPIC_API_KEY=

# Agent model and reasoning effort (low | medium | high | xhigh | max).
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=medium

# Model used as LLM-as-judge by the evaluation pipeline (M5).
JUDGE_MODEL=claude-sonnet-5-5

# Deadline of a single LLM call, and of a whole agent run (must be >= the
# former). Enforced with AbortSignal because the SDK retries timeouts.
LLM_TIMEOUT_MS=45000
AGENT_RUN_DEADLINE_MS=90000

# Maximum tool-calling iterations per agent run.
AGENT_MAX_STEPS=8

# Global daily spending cap in USD (sum of today's UTC runs in the database),
# checked before every run (M4).
DAILY_BUDGET_USD=2

# Hard ceiling on one agent run's cost in USD (optional; default 0.1). The loop
# checks a worst case that includes max output tokens, so raise it when the
# agent model is Sonnet or Opus (e.g. for the evaluation comparison).
AGENT_MAX_RUN_COST_USD=

# Canary token placed in the system prompt to detect prompt leaks (optional;
# at least 16 letters or digits). Defaults to an HMAC derived from SESSION_SECRET.
AGENT_CANARY_TOKEN=

# -----------------------------------------------------------------------------
# Data retention
# -----------------------------------------------------------------------------

# Conversations inactive for more than this many whole days (1 to 3650) are
# deleted with their messages, runs and feedback. The API purges at startup and
# every 24 hours; `npm run purge` (or `node dist/cli/purge.js` in the image,
# `--dry-run` to count only) does it on demand or from a cron job. The UI and
# SECURITY.md announce 30 days: change them too if you change this.
RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Observability: Langfuse (M3; optional)
# -----------------------------------------------------------------------------

# Set both keys or neither. Without keys, tracing is a no-op.
LANGFUSE_PUBLIC_KEY=
# SECRET.
LANGFUSE_SECRET_KEY=
# EU region by default.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# Embeddings (M2)
# -----------------------------------------------------------------------------

# Local ONNX model run on CPU through Transformers.js (384 dimensions; must
# match the `vector(384)` column).
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# Where model files are downloaded and cached (git-ignored). Relative paths
# resolve from the process working directory: use an absolute path when you
# start the API from services/api, or the model is downloaded again.
EMBEDDING_CACHE_DIR=.cache/models

# -----------------------------------------------------------------------------
# Web client (apps/web, read at build time by Vite)
# -----------------------------------------------------------------------------

# Base URL of the API. Empty = same origin (Vite dev proxy, nginx in the web
# container), which is the recommended setup.
VITE_API_BASE_URL=
