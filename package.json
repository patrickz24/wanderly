{
  "name": "wanderly",
  "private": true,
  "type": "module",
  "description": "Wanderly — an agentic travel assistant (portfolio demo): tool-calling agent, hybrid RAG, LLM evals, Langfuse observability.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
    "services/api",
    "apps/web",
    "evals"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p data/tsconfig.json",
    "test": "npm run test --workspaces --if-present && vitest run --root data",
    "build": "npm run build --workspaces --if-present",
    "prepare": "husky",
    "dev:api": "npm run dev -w @wanderly/api",
    "dev:web": "npm run dev -w @wanderly/web",
    "migrate": "npm run migrate -w @wanderly/api",
    "test:integration": "npm run test:integration -w @wanderly/api",
    "ingest": "npm run ingest -w @wanderly/api",
    "purge": "npm run purge -w @wanderly/api --",
    "chat": "npm run chat -w @wanderly/api --",
    "eval:retrieval": "npm run eval:retrieval -w @wanderly/evals --",
    "eval": "npm run eval -w @wanderly/evals",
    "eval:agent": "npm run eval:agent -w @wanderly/evals --",
    "eval:controls": "npm run eval:controls -w @wanderly/evals",
    "eval:judge-calibration": "npm run eval:judge-calibration -w @wanderly/evals --"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wtf_wikipedia": "^10.4.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node": false,
    "protobufjs": false,
    "wtf_wikipedia": false
  }
}
