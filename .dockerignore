# Build context = repo root (both Dockerfiles). Keep it small, reproducible and secret-free:
# images are built from sources + lockfile only, never from a host node_modules or build output.

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/dist
**/build
**/coverage
**/*.tsbuildinfo

# Secrets and local environment (never baked into an image layer)
**/.env
**/.env.*
**/*.pem
**/*.key

# VCS, CI, editor and tooling noise
.git
.github
.husky
.idea
.vscode
.claude
**/.DS_Store
**/Thumbs.db
**/*.log
**/npm-debug.log*

# Caches (embedding models are downloaded at runtime into a volume)
**/.cache
models-cache

# Not needed to build or run the images
docs
infra
**/*.md
docker-compose*.yml
Makefile

# Evals: only the manifest is needed (npm workspaces + lockfile check)
evals/*
!evals/package.json

# Data: only the corpus, which the API image ships for the ingestion CLI (with its ATTRIBUTION.md);
# not the download cache, the climate inputs or the generation scripts. Last, so that it also
# re-includes the corpus Markdown excluded by **/*.md above.
data/*
!data/corpus
